# Strapiのベースリポジトリ URL（ローカル起動時は http://localhost:1337）
# 未設定の場合、Blogページは src/data/blogFallback.ts のサンプルデータを表示します。
VITE_STRAPI_URL=http://localhost:1337

# 外部API連携: Works ページに公開リポジトリを自動表示するためのGitHubユーザー名
VITE_GITHUB_USERNAME=your-github-username

# EmailJS（https://www.emailjs.com/ でアカウント作成後、Service / Template / Public Key を発行）
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
